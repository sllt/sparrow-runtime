# Copy to /etc/sparrow/production.env, mode 0600. Replace the token/key path.
# Do NOT use this placeholder as a deployment token.
SPARROW_TOKEN=REPLACE_WITH_A_RANDOM_MANAGEMENT_TOKEN
SPARROW_BIND=127.0.0.1:43180
SPARROW_CATALOG=/var/lib/sparrow/catalog.db
SPARROW_DATA_ROOTS=/var/lib/sparrow/data:/var/lib/sparrow/checkpoints
SPARROW_SECRETS_KEY_FILE=/etc/sparrow/secrets.key
SPARROW_REQUIRE_SECRETS_KEY=1
SPARROW_MAX_JOBS=16
RUST_LOG=info
# Optional script plugins (Linux GNU); independent of the trusted native switch.
# SPARROW_PLUGIN_DIR=/var/lib/sparrow/plugins
# SPARROW_ENABLE_SCRIPT_PLUGINS=1
# SPARROW_JS_WORKER=/opt/sparrow/current/bin/sparrow-js-worker
# Safe mode refuses activation even when enabled here.
# Optional WASM or trusted external Source/Sink/Transform programs, independent switches.
# SPARROW_ENABLE_WASM_PLUGINS=1
# SPARROW_WASM_WORKER=/opt/sparrow/current/bin/sparrow-wasm-worker
# SPARROW_ENABLE_EXTERNAL_PLUGINS=1
# External native programs retain service-UID filesystem/network access; not a tenant sandbox.
# SPARROW_PLUGIN_TRUST_STORE=/etc/sparrow/plugin-publishers.json
