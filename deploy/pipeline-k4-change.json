{
  "version": 1,
  "stream": "telemetry",
  "source": {
    "kind": "file",
    "path": "/var/lib/sparrow/data/k4-change.ndjson",
    "file_contract": "append_only",
    "inbox_capacity": 8
  },
  "sink": {
    "kind": "http",
    "url": "http://127.0.0.1:18081/telemetry",
    "outbox_capacity": 8,
    "batch_rows": 32,
    "linger_ms": 5
  },
  "recovery": "aligned",
  "checkpoint_dir": "/var/lib/sparrow/checkpoints/k4-change",
  "checkpoint": {
    "interval_ms": 1000,
    "timeout_ms": 5000,
    "retain_generations": 3,
    "resume_latest": true
  },
  "graph": {
    "version": 1,
    "pipeline_id": 401,
    "revision_id": 1,
    "nodes": [
      {"id": 1, "kind": "memory_source", "table": "telemetry", "out": [2]},
      {
        "id": 2,
        "kind": "change_detect",
        "iot": {
          "keys": ["device_id"],
          "fields": ["temperature"],
          "emit_first": true,
          "ttl_micros": 0,
          "max_keys": 1024,
          "invalid": "ignore"
        },
        "out": [3]
      },
      {"id": 3, "kind": "capture_sink", "name": "changed"}
    ]
  }
}
