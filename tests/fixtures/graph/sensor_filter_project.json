      "out": [3]
    },
    {
      "id": 3,
      "kind": "project",
      "exprs": [
        { "alias": "device_id", "expr": { "k": "col", "name": "device_id" } },
        { "alias": "temperature", "expr": { "k": "col", "name": "temperature" } },
        { "alias": "ts", "expr": { "k": "col", "name": "ts" } }
      ],
      "out": [4]
    },
    { "id": 4, "kind": "capture_sink", "name": "capture" }
  ]
